{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Events and IPC channels for the main window",
  "windows": ["main"],
  "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:app:allow-version", "core:webview:allow-print", "core:resources:allow-close", "updater:allow-check", "updater:allow-download", "updater:allow-install", "process:allow-restart", "dialog:allow-open", "dialog:allow-save", { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/dsgnr/ShotTrainer" }, { "url": "https://github.com/dsgnr/ShotTrainer/releases" }] }]
}
